<?xml version="1.0"?>
<package >
	<metadata>
		<id>DLaB.Xrm.EarlyBoundGeneratorV2.Api</id>
		<version>2.2026.9.20</version>
		<title>Early Bound Generator V2 Api</title>
		<authors>Daryl LaBar</authors>
		<owners>Daryl LaBar</owners>
		<license type="expression">MIT</license>
		<icon>images\DLaB_Dynamics_Logo_Square_32x32.png</icon>
		<projectUrl>https://github.com/daryllabar/DLaB.Xrm.XrmToolBoxTools</projectUrl>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<description>Generates Early Bound Entities/Option Sets/Actions Without XrmToolBox Dependencies.  Uses ModelBuilder from the PAC.</description>
		<releaseNotes>V2.2026.9.20
Utilize OOB Obsolete logic #554
DateTime Sub-Type added to generated DateTime properties #509

V2.2026.7.28
OptionSetMetadataAttribute Generates Null Ref Warnings #617

V2.2026.7.26
EntityOptionSetEnum Generates Null Ref Warnings #616

V2.2026.7.23
CS8604 for Entity Sets #613
Unboxing Error for Custom Constructor with Nullable Ref Values #612
Fix language inconsistency in EBG V2 generated labels #570

V2.2026.6.7
Obsolete attributed should be added to Field Name too, not only to Property #571

V2.2026.6.4
Added support for .NET 10.0

V2.2026.5.12
Custom API message response set fails #603
Update Name and folder while writing metadata to xml file #604
Fix for Incorrect English #600

V2.2026.4.21
Fix for class generated for custom api #594

V2.2026.4.19
Fix Missing dll References for Microsoft.PowerPlatform.Dataverse.ModelBuilderLib #593
Fix Issue with the capitalization of generated attributes in messages closes #579

V2.2.2025.11.14
Nuspec contentFiles folder fix #575
Duplicate relationship within AsyncOperation when having 2 Business Process Flows #569
File attributes don't have the file name that ends with _name #568
Fix for how to utilize "Option Name Overrides" effectively? #565
		</releaseNotes>
		<copyright>Copyright 2019</copyright>
		<tags>PAC ModelBuilder Dataverse Xrm EarlyBound Generator</tags>
		<frameworkAssemblies>
			<frameworkAssembly assemblyName="System.Configuration" />
			<frameworkAssembly assemblyName="System.Runtime.Serialization" />
		</frameworkAssemblies>
		<contentFiles>
			<files include="any\any\DLaB.EarlyBoundGeneratorV2\**\*.*" buildAction="None" copyToOutput="true" />
		</contentFiles>
		<dependencies>
			<group targetFramework=".NETFramework4.8">
				<dependency id="Microsoft.PowerPlatform.Dataverse.ModelBuilderLib" version="2.0.16" />
			</group>
			<group targetFramework="net10.0">
				<dependency id="Microsoft.PowerPlatform.Dataverse.ModelBuilderLib" version="2.0.16" />
			</group>
		</dependencies>
	</metadata>
	<files>
		<!-- lib -->
		<file src="bin\Release\net48\DLaB.*.*" target="lib\net48" />
		<file src="bin\Release\net10.0\DLaB.*.*" target="lib\net10.0" />
		<!-- content -->
		<file src="bin\Release\net48\DLaB.Dictionary.txt" target="content\bin\DLaB.EarlyBoundGeneratorV2\DLaB.Dictionary.txt" />
		<file src="bin\Release\net48\alphabets\*.*" target="content\bin\DLaB.EarlyBoundGeneratorV2\alphabets" />
		<!-- contentFiles -->
		<file src="bin\Release\net48\DLaB.Dictionary.txt" target="contentFiles\bin\DLaB.EarlyBoundGeneratorV2\DLaB.Dictionary.txt" />
		<file src="bin\Release\net48\alphabets\*.*" target="contentFiles\any\any\DLaB.EarlyBoundGeneratorV2\alphabets" />
		<!-- images -->
		<file src="bin\Release\net48\Images\DLaB_Dynamics_Logo_Square_32x32.png" target="images\" />
	</files>
</package>
