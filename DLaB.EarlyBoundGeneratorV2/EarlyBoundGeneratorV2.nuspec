<?xml version="1.0"?>
<package >
  <metadata>
    <id>DLaB.Xrm.EarlyBoundGeneratorV2</id>
	  <version>2.2026.9.20</version>
	  <title>Early Bound Generator V2</title>
    <authors>Daryl LaBar</authors>
    <owners>Daryl LaBar</owners>
    <license type="expression">MIT</license>
    <icon>images\DLaB_Dynamics_Logo_Square_32x32.png</icon>
    <projectUrl>https://github.com/daryllabar/DLaB.Xrm.XrmToolBoxTools</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Generates Early Bound Entities/Option Sets/Messages.  Uses the DataverseModelBuilder from the SDK, and shows command line used to create the classes.</description>
		<releaseNotes>V2.2026.9.20
Utilize OOB Obsolete logic #554
DateTime Sub-Type added to generated DateTime properties #509

V2.2026.7.28
OptionSetMetadataAttribute Generates Null Ref Warnings #617

V2.2026.7.26
EntityOptionSetEnum Generates Null Ref Warnings #616

V2.2026.7.23
CS8604 for Entity Sets #613
Unboxing Error for Custom Constructor with Nullable Ref Values #612
Fix language inconsistency in EBG V2 generated labels #570
Skip writing serializedMetadataRelativeFilePath when metadata serialization is unused #609

V2.2026.6.7
Obsolete attributed should be added to Field Name too, not only to Property #571

V2.2026.5.12
Custom API message response set fails #603
Update Name and folder while writing metadata to xml file #604
Fix for Incorrect English #600

V2.2026.5.5
Error when opening Message Whitelist #598

V2.2026.4.23
Unable to open Entities Whitelist #596

V2.2026.4.21
Fix for class generated for custom api #594

V2.2026.4.19
Fix Missing dll References for Microsoft.PowerPlatform.Dataverse.ModelBuilderLib #593
Fix Issue with the capitalization of generated attributes in messages closes #579

V2.2.2025.11.14
Duplicate relationship within AsyncOperation when having 2 Business Process Flows #569
File attributes don't have the file name that ends with _name closes #568
Fix for how to utilize "Option Name Overrides" effectively? #565
		</releaseNotes>
    <copyright>Copyright 2019</copyright>
	  <tags>PAC ModelBuilder Dataverse Xrm EarlyBound Generator XrmToolBox Plugins</tags>
    <dependencies>
      <!-- Group must match lib\net48\ so pack does not warn NU5128 -->
      <group targetFramework=".NETFramework4.8">
        <dependency id="XrmToolBox" version="1.2023.12.68" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\net48\DLaB.EarlyBoundGeneratorV2.dll"             target="lib\net48\plugins" />
    <file src="bin\Release\net48\DLaB.EarlyBoundGeneratorV2\*.*"             target="lib\net48\plugins\DLaB.EarlyBoundGeneratorV2" exclude="bin\Release\DLaB.EarlyBoundGeneratorV2.dll" />
    <file src="bin\Release\net48\DLaB.EarlyBoundGeneratorV2\alphabets\*.*"   target="lib\net48\plugins\DLaB.EarlyBoundGeneratorV2\alphabets" />
    <file src="bin\Release\net48\Images\DLaB_Dynamics_Logo_Square_32x32.png" target="images\" />
  </files>
</package>
